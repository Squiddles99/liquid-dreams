{
  "name": "liquid-dreams",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:surfers": "node tools/surfer/buildSurfers.ts",
    "build:heath": "node tools/heath/buildHeath.ts",
    "electron": "npm run build && electron .",
    "electron:dev": "electron . --dev",
    "build:clips": "node tools/surfer/buildSurfers.ts --clips"
  },
  "dependencies": {
    "stats-gl": "4.2.3",
    "three": "0.186.1",
    "tweakpane": "4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "2.0.5",
    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.74",
    "electron": "^44.5.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "main": "electron/main.js"
}
